<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{48F785A6-2355-49EC-8CBE-E57FDDFD8CA8}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>XmlDocPlugin.dpk</MainSource>
    <ProjectName>XmlDocPlugin</ProjectName>
    <AppType>Package</AppType>
    <FrameworkType>VCL</FrameworkType>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <TargetedPlatforms>1</TargetedPlatforms>
    <Base>true</Base>
    <GenDll>true</GenDll>
    <GenPackage>true</GenPackage>
    <DesignOnlyPackage>true</DesignOnlyPackage>
    <DllSuffix>$(Auto)</DllSuffix>
    <DCC_Namespace>System;System.Win;Winapi;Vcl;Vcl.Samples;Xml;Data;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitSearchPath>..\..\..\vendor\DelphiAST\Source;..\..\..\vendor\DelphiAST\Source\SimpleParser;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_CodePage>65001</DCC_CodePage>
    <DCC_Description>XmlDoc Plugin - XML Documentation WYSIWYG Editor</DCC_Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <BuildConfiguration Include="Debug"><Key>Cfg_Debug</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Cfg_Release</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions><Borland.Personality>Delphi.Personality.12</Borland.Personality><BorlandProject><Platforms><Platform value="Win32">True</Platform></Platforms></BorlandProject></ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
